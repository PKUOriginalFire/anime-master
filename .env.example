# 仅在空数据库首次启动时创建管理员；恢复已有数据库后以数据库中的账号为准。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 站点公开来源，必须包含协议和端口，不能带路径。
APP_ORIGIN=http://127.0.0.1:3010
# 额外允许的完整来源，逗号分隔；留空只使用 APP_ORIGIN 与本机默认来源。
APP_ALLOWED_ORIGINS=

# examples：公开仓库以空题库启动；full：需要私有 seed/full-deck.json 与 seed/media。
SEED_PROFILE=examples
AUTHOR_INITIAL_PASSWORD=replace-with-another-long-random-password

# Compose 可选覆盖，默认值兼容 /opt/anime-quiz 部署。
# APP_PORT=3010
# DATA_DIR_HOST=/opt/anime-quiz/data
# RELEASE_TAG=local
