# 复制到 /etc/nginx/conf.d/anime-quiz.conf，并替换域名与证书路径。
# 先用 certbot 取得证书；proxy_pass 端口需与 compose.yaml 的 APP_PORT 一致。
server {
    listen 80;
    server_name quiz.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name quiz.example.com;
    ssl_certificate /etc/letsencrypt/live/quiz.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quiz.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 201m;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }
}
